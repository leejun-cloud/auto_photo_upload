FIREBASE_SERVICE_ACCOUNT_B64=

# Firebase 인증 (클라이언트) — Firebase 콘솔 > 프로젝트 설정 > 웹 앱 config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI metadata generation
# Vision (image understanding): Google Gemini
GEMINI_API_KEY=
AI_VISION_MODEL=gemini-2.5-flash
# Text refinement (title/description/keywords): DeepSeek via OpenRouter
OPENROUTER_API_KEY=
AI_TEXT_MODEL=deepseek/deepseek-chat

# 데이터 백엔드 선택: 미설정=SQLite(로컬)/Postgres(DATABASE_URL 있으면), 'firestore'=Firestore
DB_BACKEND=
# 미디어 저장 백엔드: 미설정=로컬파일, 's3'=S3호환, 'firebase'=Firebase Cloud Storage
STORAGE_BACKEND=
# Firebase Storage 버킷 (STORAGE_BACKEND=firebase 일 때). 예: your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# 업로드 최대 파일 크기 (바이트). 미설정 시 기본 200MB (동영상 대응)
MAX_UPLOAD_BYTES=209715200

# 잡 큐 크론 시크릿 — /api/jobs/tick 호출 시 x-cron-secret 헤더와 대조 (Vercel Cron 인증용)
CRON_SECRET=
